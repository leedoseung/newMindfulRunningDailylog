#!/usr/bin/env bash
# pre-commit: 커밋 전 게이트
# 생성됨: install-harness (npm)

set -e

STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)

if [ -z "$STAGED_TS" ]; then
  echo "ℹ️  TS 변경 없음. 스킵."
  exit 0
fi

STAGED_COUNT=$(echo "$STAGED_TS" | wc -l | tr -d ' ')
echo "🔍 pre-commit: TS 파일 ${STAGED_COUNT}개 검사"

echo "→ Lint (staged only)..."
if ! echo "$STAGED_TS" | xargs npx eslint --max-warnings=0 2>&1; then
  echo ""
  echo "❌ Lint 실패 (staged 파일)."
  exit 1
fi

echo "→ Typecheck..."
if ! npm run typecheck 2>&1; then
  echo ""
  echo "❌ Typecheck 실패."
  exit 1
fi

# --changed 지원 시도 (vitest)
echo "→ Test (changed)..."
if ! npx vitest run --changed 2>&1 | tail -20; then
  echo ""
  echo "⚠️  Changed test 실패 or 지원 X. 전체 실행:"
  if ! npm test 2>&1 | tail -20; then
    echo "❌ Test 실패."
    exit 1
  fi
fi

# Secret scan
if echo "$STAGED_TS" | xargs grep -lE '(AKIA[0-9A-Z]{16}|sk-(ant-)?[a-zA-Z0-9_-]{40,}|ghp_[a-zA-Z0-9]{36}|sbp_[a-f0-9]{40}|-----BEGIN (RSA |DSA |EC |OPENSSH )?PRIVATE KEY)' 2>/dev/null; then
  echo ""
  echo "❌ 시크릿 의심 패턴 발견."
  exit 1
fi

echo ""
echo "✓ pre-commit 통과"
